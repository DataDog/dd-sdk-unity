        public void SetFirstPartyHosts(string arg)
        {
            if (arg == "CLEAR")
            {
                _new.FirstPartyHosts.Set(new List<FirstPartyHostOption>());
            }
            else
            {
                var value = new List<FirstPartyHostOption>();
                foreach (var host in arg.Split(","))
                {
                    var opt = new FirstPartyHostOption(host, TracingHeaderType.Datadog | TracingHeaderType.TraceContext);
                    value.Add(opt);
                }
                _new.FirstPartyHosts.Set(value);
            }
            _hasNewValues = true;
        }


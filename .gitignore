# iOS XCFramework (fetched locally via dd-unity-ios-xcframework stage)
# Note: at release time, the payload push into the unity-package repo must
# `git add -f` these paths, since the binary needs to be committed there even
# though it is ignored in this dev repo.
packages/Datadog.Unity/Plugins/iOS/*.xcframework
packages/Datadog.Unity/Plugins/iOS/*.xcframework.meta
build/ios-xcframework/
